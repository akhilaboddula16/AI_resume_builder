# ─────────────────────────────────────────────
# .env.example — Copy this file to .env and fill in your real values
# NEVER commit .env to git — only commit .env.example
# ─────────────────────────────────────────────

# Groq API Key (free at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Supabase credentials (from supabase.com → project settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Supabase database direct connection (from settings → database → connection string)
DATABASE_URL=postgresql://postgres:your_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Gemini API Key (fallback LLM, free at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# App environment
ENVIRONMENT=development
